%% Diagram: Containerisation and orchestration as code — from Dockerfile through OCI image and registry to Kubernetes deployment and cluster autoscaling
flowchart TB
    subgraph Build["Container Build Pipeline"]
        A["Dockerfile /\nBuildpack"]:::geon-primary --> B["OCI\nImage"]:::geon-highlight
        B --> C["Container\nRegistry"]:::geon-accent
    end
    subgraph Orchestrate["Kubernetes Orchestration"]
        D["Helm Chart /\nKustomize"]:::geon-primary --> E["Pod\nDeployment"]:::geon-highlight
        E --> F["Service &\nIngress"]:::geon-accent
        F --> G["Horizontal Pod\nAutoscaler"]:::geon-muted
    end
    C -->|"image pull"| D
    G -->|"scales"| E
